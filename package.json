{
  "name": "redxdex-ai-bridge",
  "version": "0.9.2",
  "private": true,
  "description": "Cross-client MCP desktop bridge with local permissions UI",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "mcp": "node app/mcp.cjs",
    "test": "node scripts/test.cjs",
    "package:mac": "npm run prepare:native && electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "electron-builder --win nsis",
    "package:linux": "electron-builder --linux AppImage",
    "prepare:native": "node scripts/build-native.cjs",
    "check": "node scripts/check.cjs && npm test"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.redxai.redxdexaibridge",
    "productName": "RedXDexAiBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "identity": "Joshua Franklin (NZPU8H843J)",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "RedXDexAiBridge controls applications only when you grant a connected AI permission.",
        "NSCameraUsageDescription": "Camera access is not used by the bridge.",
        "NSMicrophoneUsageDescription": "Microphone access is not used by the bridge."
      },
      "notarize": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "grimvirusoffical-source",
        "repo": "RedXDexAiBridge",
        "releaseType": "release",
        "private": true
      }
    ],
    "extraResources": [
      {
        "from": "build/redxdex-control",
        "to": "redxdex-control"
      },
      {
        "from": "app/adapter.cjs",
        "to": "bridge-adapter.cjs"
      }
    ],
    "forceCodeSigning": true
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "author": "Red-XAI",
  "license": "UNLICENSED",
  "allowScripts": {
    "electron@45.1.0": true
  }
}
