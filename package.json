{
  "name": "redxdex-ai-bridge",
  "version": "0.10.0",
  "private": true,
  "description": "Red-XAI Bridge \u2014 permission-controlled MCP tools for macOS, Windows and Linux",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "mcp": "node app/mcp.cjs",
    "test": "node scripts/test.cjs",
    "package:mac": "npm run prepare:native && electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "npm run prepare:native && electron-builder --win nsis --x64 --publish never",
    "package:linux": "npm run prepare:native && electron-builder --linux AppImage deb --x64 --publish never",
    "prepare:native": "node scripts/build-native.cjs",
    "check": "node scripts/check.cjs && npm test"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.redxai.redxdexaibridge",
    "productName": "RedXDexAiBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "identity": "Joshua Franklin (NZPU8H843J)",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "RedXDexAiBridge controls applications only when you grant a connected AI permission.",
        "NSCameraUsageDescription": "Camera access is not used by the bridge.",
        "NSMicrophoneUsageDescription": "Microphone access is not used by the bridge."
      },
      "notarize": false,
      "forceCodeSigning": true,
      "extraResources": [
        {
          "from": "build/redxdex-control",
          "to": "redxdex-control"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "grimvirusoffical-source",
        "repo": "RedXDexAiBridge",
        "releaseType": "release",
        "private": true
      }
    ],
    "extraResources": [
      {
        "from": "app/adapter.cjs",
        "to": "bridge-adapter.cjs"
      }
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "RedXDexAiBridge-${version}-windows-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/redxdex-control.exe",
          "to": "redxdex-control.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "RedXDexAiBridge-${version}-linux-${arch}.${ext}",
      "maintainer": "Red-XAI <support@infected-nation.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2",
        "xdotool",
        "libsecret-1-0"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "author": "Red-XAI",
  "license": "UNLICENSED",
  "allowScripts": {
    "electron@45.1.0": true
  }
}
