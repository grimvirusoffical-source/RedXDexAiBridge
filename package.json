{
  "name": "redxdex-ai-bridge",
  "version": "0.10.2",
  "private": true,
  "description": "Red-XAI Bridge \u2014 permission-controlled MCP desktop tools for macOS, Windows and Linux",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "mcp": "node app/mcp.cjs",
    "test": "node scripts/test.cjs",
    "package:mac": "npm run prepare:native && npm run prepare:tunnel && electron-builder --mac dmg zip --arm64 --config.forceCodeSigning=true --publish never",
    "package:win": "npm run prepare:native && electron-builder --win nsis --x64 --publish never",
    "package:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "prepare:native": "node scripts/build-native.cjs",
    "check": "node scripts/check.cjs && npm test",
    "prepare:tunnel": "node scripts/prepare-tunnel.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.redxai.redxdexaibridge",
    "productName": "RedXDexAiBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "identity": "Joshua Franklin (NZPU8H843J)",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "RedXDexAiBridge controls applications only when you grant a connected AI permission.",
        "NSCameraUsageDescription": "Camera access is not used by the bridge.",
        "NSMicrophoneUsageDescription": "Microphone access is not used by the bridge."
      },
      "notarize": false,
      "extraResources": [
        {
          "from": "build/redxdex-control",
          "to": "redxdex-control"
        }
      ],
      "icon": "build/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "grimvirusoffical-source",
        "repo": "RedXDexAiBridge",
        "releaseType": "release",
        "private": true
      }
    ],
    "extraResources": [
      {
        "from": "app/adapter.cjs",
        "to": "bridge-adapter.cjs"
      },
      {
        "from": "build/tunnel",
        "to": "tunnel",
        "filter": [
          "cloudflared",
          "cloudflared.exe",
          "PROVENANCE.json",
          "LICENSE"
        ]
      }
    ],
    "forceCodeSigning": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/redxdex-control.exe",
          "to": "redxdex-control.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "RedXDexAiBridge-${version}-windows-${arch}-setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "Red-XAI Bridge for permission-controlled AI computer access",
      "maintainer": "Red-XAI <support@infected-nation.com>",
      "desktop": {
        "entry": {
          "Name": "Red-XAI Bridge",
          "Comment": "Permission-controlled AI desktop bridge"
        }
      },
      "syncDesktopName": true,
      "executableName": "redxdex-ai-bridge"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libsecret-1-0",
        "xdotool"
      ]
    },
    "artifactName": "RedXDexAiBridge-${version}-${os}-${arch}.${ext}",
    "afterSign": "scripts/notarize-mac.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "author": "Red-XAI",
  "license": "UNLICENSED",
  "allowScripts": {
    "electron@45.1.0": true
  },
  "homepage": "https://red-xai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/grimvirusoffical-source/RedXDexAiBridge.git"
  },
  "desktopName": "redxdex-ai-bridge.desktop"
}
